# Kafka KRaft
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_NUM_PARTITIONS=3

# ClickHouse
CLICKHOUSE_DB=events
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=secret
# HTTP endpoint inside the docker network (the clickhouse crate talks over HTTP 8123)
CLICKHOUSE_URL=http://events-clickhouse:8123

# Service addresses inside the docker network (host ports are below, in the Ports section)
KAFKA_BROKERS=events-kafka:29092

# Ports (host)
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8081
INGESTION_API_HOST_PORT=8080
ANALYTICS_API_HOST_PORT=8082
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
TABIX_HOST_PORT=8083

# App
RUST_LOG=info

# Container ports
ANALYTICS_API_CONTAINER_PORT=8080
